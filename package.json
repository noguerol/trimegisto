{
  "name": "trimegisto",
  "version": "1.0.0",
  "description": "Multi-agent orchestration for pi: parallel sub-agents in tiers (active/t1/t2/t3), @mention steering, loop supervisor, advisory file locks, context broker and a live dashboard. Installs as a pi package with one extension + three tier skills.",
  "keywords": [
    "pi-package",
    "multi-agent",
    "orchestration",
    "subagents",
    "parallel",
    "agents"
  ],
  "author": "Javier Noguerol <https://github.com/noguerol>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noguerol/trimegisto"
  },
  "homepage": "https://github.com/noguerol/trimegisto",
  "bugs": {
    "url": "https://github.com/noguerol/trimegisto/issues"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./agents"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "files": [
    "src",
    "agents"
  ]
}
